  "segments": [
    {
      "code": "01a",
      "who": "narrator",
      "line": 1,
      "tag": "[hushed, awed, solar]",
      "spoken": "सूरज का बेटा... जिसे कोई हथियार छू भी नहीं सकता था।",
      "file": "audio/vo/01a_narrator_line01.mp3"
    },
    {
      "code": "02a",
      "who": "narrator",
      "line": 2,
      "tag": "[warm, revealing]",
      "spoken": "नाम था कर्ण। जन्म से ही उसके शरीर पर सोने का कवच था... और कानों में कुंडल।",
      "file": "audio/vo/02a_narrator_line02.mp3"
    },
    {
      "code": "03a",
      "who": "narrator",
      "line": 3,
      "tag": "[firm, weighty]",
      "spoken": "जब तक कवच था, कर्ण को कोई नहीं मार सकता था। अर्जुन भी नहीं।",
      "file": "audio/vo/03a_narrator_line03.mp3"
    },
    {
      "code": "04a",
      "who": "narrator",
      "line": 4,
      "tag": "[low, ominous]",
      "spoken": "ये बात इंद्र जानते थे... अर्जुन के पिता।",
      "file": "audio/vo/04a_narrator_line04.mp3"
    },
    {
      "code": "05a",
      "who": "narrator",
      "line": 5,
      "tag": "[mysterious, night-time]",
      "spoken": "सूर्य देव ने सपने में कर्ण को चेताया —",
      "file": "audio/vo/05a_narrator_line05.mp3"
    },
    {
      "code": "05b",
      "who": "surya",
      "line": 5,
      "tag": "[divine, grave, loving warning]",
      "spoken": "कल एक ब्राह्मण आएगा। कुछ भी दे देना... पर कवच मत देना।",
      "file": "audio/vo/05b_surya_line05.mp3"
    },
    {
      "code": "06a",
      "who": "narrator",
      "line": 6,
      "tag": "[expectant, soft]",
      "spoken": "कर्ण मुस्कुराए —",
      "file": "audio/vo/06a_narrator_line06.mp3"
    },
    {
      "code": "06b",
      "who": "karna",
      "line": 6,
      "tag": "[proud, gentle, unshakable]",
      "spoken": "मेरे दरवाज़े से कोई ख़ाली हाथ नहीं जाता।",
      "file": "audio/vo/06b_karna_line06.mp3"
    },
    {
      "code": "07a",
      "who": "narrator",
      "line": 7,
      "tag": "[bright dawn, turning tense]",
      "spoken": "अगली सुबह, जब कर्ण सूर्य को जल चढ़ा रहे थे... इंद्र ब्राह्मण बनकर आए। और माँगा —",
      "file": "audio/vo/07a_narrator_line07.mp3"
    },
    {
      "code": "07b",
      "who": "indra",
      "line": 7,
      "tag": "[controlled, testing, majestic]",
      "spoken": "कवच और कुंडल।",
      "file": "audio/vo/07b_indra_line07.mp3"
    },
    {
      "code": "08a",
      "who": "narrator",
      "line": 8,
      "tag": "[slow, heavy heartbeat]",
      "spoken": "कर्ण जानते थे... ये उनकी मौत की माँग है।",
      "file": "audio/vo/08a_narrator_line08.mp3"
    },
    {
      "code": "09a",
      "who": "narrator",
      "line": 9,
      "tag": "[reverent, stunned, slow]",
      "spoken": "फिर भी उन्होंने अपने ही हाथों से... कवच उतारकर दे दिया।",
      "file": "audio/vo/09a_narrator_line09.mp3"
    },
    {
      "code": "10a",
      "who": "narrator",
      "line": 10,
      "tag": "[humbled, awed]",
      "spoken": "इंद्र का सिर झुक गया। बदले में उन्होंने कर्ण को एक अमोघ शक्ति दी... जो एक बार चलती, तो ख़ाली नहीं जाती।",
      "file": "audio/vo/10a_narrator_line10.mp3"
    },
    {
      "code": "11a",
      "who": "narrator",
      "line": 11,
      "tag": "[noble, emotional, resolved]",
      "spoken": "कर्ण ने अपनी जान का कवच दे दिया... पर अपना वचन नहीं तोड़ा।",
      "file": "audio/vo/11a_narrator_line11.mp3"
    },
    {
      "code": "12a",
      "who": "narrator",
      "line": 12,
      "tag": "[warm, triumphant, devotional]",
      "spoken": "इसीलिए आज भी दुनिया कहती है — दानवीर कर्ण।",
      "file": "audio/vo/12a_narrator_line12.mp3"
    }
  ]
}